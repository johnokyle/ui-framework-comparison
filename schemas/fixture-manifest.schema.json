{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-framework-comparison.local/schemas/fixture-manifest.schema.json",
  "title": "Versioned generated fixture family manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "title",
    "classification",
    "generator",
    "entity_identity",
    "rng",
    "normalization",
    "numeric_oracle",
    "formulas",
    "variants",
    "extensions",
    "separation_notes",
    "references"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["rendering", "numerical"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": { "const": "common-fixture-generator" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "entity_identity": {
      "type": "object",
      "required": ["rule", "ordering"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "ordering": { "type": "string", "minLength": 1 },
        "id_column": { "type": "string" }
      },
      "additionalProperties": true
    },
    "rng": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "seed", "state", "output", "uniform", "below", "normal", "draw_order"],
          "properties": {
            "algorithm": { "const": "SplitMix64" },
            "seed": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 },
            "output": { "type": "string", "minLength": 1 },
            "uniform": { "type": "string", "minLength": 1 },
            "below": { "type": "string", "minLength": 1 },
            "normal": { "type": "string", "minLength": 1 },
            "draw_order": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          }
        }
      ]
    },
    "normalization": {
      "type": "object",
      "required": [
        "encoding",
        "document",
        "object_keys",
        "array_order",
        "numbers",
        "integers",
        "negative_zero",
        "nonfinite",
        "nulls",
        "booleans",
        "strings",
        "dates",
        "datetimes",
        "line_endings"
      ],
      "properties": {
        "encoding": { "const": "UTF-8 without BOM" },
        "document": { "type": "string" },
        "object_keys": { "type": "string" },
        "array_order": { "type": "string" },
        "numbers": { "type": "string" },
        "integers": { "type": "string" },
        "negative_zero": { "type": "string" },
        "nonfinite": { "type": "string" },
        "nulls": { "type": "string" },
        "booleans": { "type": "string" },
        "strings": { "type": "string" },
        "dates": { "type": "string" },
        "datetimes": { "type": "string" },
        "line_endings": { "type": "string" }
      },
      "additionalProperties": true
    },
    "numeric_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculation", "absolute_tolerance", "relative_tolerance", "display_formatting"],
      "properties": {
        "calculation": { "type": "string" },
        "absolute_tolerance": { "type": "number", "minimum": 0 },
        "relative_tolerance": { "type": "number", "minimum": 0 },
        "display_formatting": { "type": "string" }
      }
    },
    "formulas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selection", "dimensions", "artifacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "selection": { "enum": ["default", "on-demand"] },
          "dimensions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["integer", "number", "string", "boolean", "array", "null"]
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "row_count", "columns", "golden_samples", "sha256"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
                "description": { "type": "string", "minLength": 1 },
                "row_count": { "type": "integer", "minimum": 1 },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "type", "nullable"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                      "label": { "type": "string" },
                      "type": { "enum": ["string", "integer", "number", "boolean", "date", "datetime", "number[]"] },
                      "nullable": { "type": "boolean" },
                      "width": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                },
                "golden_samples": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["selector", "row"],
                    "properties": {
                      "selector": { "type": "string", "pattern": "^row\\[[0-9]+\\]$" },
                      "row": {
                        "type": "array",
                        "items": {
                          "type": ["string", "integer", "number", "boolean", "array", "null"]
                        }
                      }
                    }
                  }
                },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "extensions": { "type": "array", "items": { "type": "string" } },
    "separation_notes": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "artifact_ids", "reason"],
        "properties": {
          "family": { "type": "string" },
          "artifact_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
