{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI framework comparison scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "tier",
    "status",
    "title",
    "description",
    "implementations",
    "fixture",
    "workload",
    "environment",
    "actions",
    "measurements",
    "deviations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "tier": { "enum": ["core", "slint-qml", "framework-specific"] },
    "status": { "enum": ["draft", "active", "retired"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "implementations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["slint", "qml", "bevy-egui"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "page_id", "support", "provision", "notes"],
        "properties": {
          "repository": {
            "enum": [
              "slint-ui-comparison",
              "qml-ui-comparison",
              "bevy-egui-ui-comparison"
            ]
          },
          "page_id": { "type": "string", "minLength": 1 },
          "support": {
            "enum": [
              "unverified",
              "supported",
              "partial",
              "not-implemented",
              "not-applicable",
              "not-comparable"
            ]
          },
          "provision": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["NATIVE", "COMPOSED", "CUSTOM", "EXTERNAL", "EXPERIMENTAL"]
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "id", "revision", "sha256", "notes"],
      "properties": {
        "mode": {
          "enum": ["shared-file", "shared-generator", "implementation-generator"]
        },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": { "type": "string" }
      }
    },
    "workload": { "type": "object" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "theme", "build_profile", "warm_up_seconds"],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "scale_factor"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "scale_factor": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "theme": { "enum": ["light", "dark", "system", "implementation-default"] },
        "build_profile": { "enum": ["debug", "release"] },
        "warm_up_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "measurements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "active" } }
      },
      "then": {
        "properties": {
          "fixture": {
            "properties": {
              "mode": { "enum": ["shared-file", "shared-generator"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "actions": { "minItems": 1 },
          "measurements": { "minItems": 1 }
        }
      }
    }
  ]
}
