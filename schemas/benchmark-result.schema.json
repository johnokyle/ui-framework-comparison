{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI framework comparison benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "scenario_revision",
    "implementation",
    "source_commit",
    "collected_at",
    "machine",
    "build",
    "measurements",
    "artifacts",
    "deviations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scenario_revision": { "type": "integer", "minimum": 1 },
    "implementation": { "enum": ["slint", "qml", "bevy-egui"] },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "collected_at": { "type": "string", "format": "date-time" },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "kernel",
        "cpu",
        "memory_gb",
        "gpu",
        "driver",
        "compositor",
        "rendering_backend"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
        "gpu": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "compositor": { "type": "string", "minLength": 1 },
        "rendering_backend": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "compiler", "framework_versions", "cache_state"],
      "properties": {
        "profile": { "enum": ["debug", "release"] },
        "compiler": { "type": "string", "minLength": 1 },
        "framework_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "cache_state": { "enum": ["clean", "dependencies-cached", "incremental", "warm"] }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "unit", "samples", "summary"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number" }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["median", "minimum", "maximum"],
            "properties": {
              "median": { "type": "number" },
              "p95": { "type": "number" },
              "p99": { "type": "number" },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
